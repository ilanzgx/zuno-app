# Copie este arquivo para .env na mesma pasta:
# cp .env.example .env

# --- Banco de Dados e Cache ---
# Se estiver usando o docker compose da raiz, esses valores padrao ja funcionam direto.
DB_URL=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- Seguranca e Auth ---
# Chave HMAC-SHA de pelo menos 256 bits para assinar os tokens JWT.
# Voce pode gerar uma chave rapida no terminal com: openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_longa_e_aleatoria_com_pelo_menos_32_bytes

# --- Cotacoes e Mercado ---
# Crie uma conta gratuita em https://brapi.dev para pegar seu token pessoal de cotacoes da B3.
BRAPI_URL=https://brapi.dev
BRAPI_TOKEN=seu_token_da_brapi

# URL onde o microservico Python (apps/market) esta rodando.
MARKET_SERVICE_URL=http://localhost:8000