{
  "name": "zuno-app",
  "version": "1.0.0",
  "private": true,
  "description": "Consolidador de Investimentos - Monorepo",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB,MARKET\" -c \"bgBlue.bold,bgCyan.bold,bgGreen.bold\" \"pnpm run start:api\" \"pnpm run start:web\" \"pnpm run start:market\"",
    "start:web": "pnpm --filter @consolidador-investimentos/web dev",
    "start:api": "cd apps/api && mvnw spring-boot:run",
    "start:market": "uv run --directory apps/market uvicorn src.main:app --reload",
    "infra:up": "docker compose up -d database redis pgadmin",
    "infra:down": "docker compose down",
    "test": "task test",
    "test:api": "task test:api",
    "test:market": "task test:market",
    "test:all": "task test:all",
    "build:web": "pnpm --filter @consolidador-investimentos/web build",
    "build:api": "task build:api",
    "build:all": "task build:all",
    "maven:resolve": "cd apps/api && mvnw dependency:resolve",
    "maven:build": "cd apps/api && mvnw clean install -DskipTests",
    "maven:list": "cd apps/api && mvnw dependency:tree"
  },
  "keywords": [],
  "author": "ilanzgx",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
